# Copiez ce fichier en .env pour le développement local (ne le déposez jamais sur GitHub).
# Utilisation : node --env-file=.env server.js

# Connexion des responsables de formation.
# Option simple : un mot de passe partagé, chacun saisit son prénom.
ADMIN_PASSWORD=changez-moi
# Option nominative (remplace ADMIN_PASSWORD) : prénom:motdepasse séparés par des virgules
# ADMIN_USERS=Tanya:mot-de-passe-1,Hélène:mot-de-passe-2

# Secret de signature des sessions (longue chaîne aléatoire)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Optionnel : rédaction des synthèses par Claude (seuls les scores sont envoyés)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Nombre de réponses dangereuses (sécurité, honnêteté) qui déclenche une alerte. 1 = strict
ALERT_MIN=1

# Conservation des dossiers en mois (RGPD)
RETENTION_MONTHS=24

# Temps laissé au candidat pour chaque étape d'une situation (en secondes)
QUESTION_SECONDS=60

# Nombre de jours sans passage (depuis l'envoi ou la dernière relance) avant qu'un
# candidat apparaisse « à relancer » dans le tableau de bord
REMINDER_DAYS=2

# Production uniquement : fourni automatiquement par Render
# DATABASE_URL=
